---
// The few icons the incident banner and pages use, inline so the kit needs no
// icon library. Replace with your theme's icon component if it has one.
const { name, class: className } = Astro.props as {
	name: "warning" | "check-circle" | "phone" | "email" | "rss" | "thumbtack";
	class?: string;
};
const PATHS: Record<string, string> = {
	warning: "M12 3 2 21h20L12 3Zm0 6v5m0 3.5v.5",
	"check-circle": "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-4-9 3 3 5-6",
	phone: "M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z",
	email: "M3 5h18v14H3V5Zm0 0 9 7 9-7",
	rss: "M5 19a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16",
	thumbtack: "M9 3h6l-1 6 4 4H6l4-4-1-6Zm3 10v8",
};
---

<svg
	class:list={["incident-icon", className]}
	viewBox="0 0 24 24"
	width="1em"
	height="1em"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"><path d={PATHS[name]}></path></svg
>
